# Server-side configuration (do NOT prefix with VITE_)
PORT=5001
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GROQ_API_KEY=your-groq-api-key
MATCH_THRESHOLD=0.75

# LLM provider configuration ('groq' or 'ollama')
LLM_PROVIDER=groq
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Client-side configuration (must be VITE_-prefixed)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# API base path - change to '/server/your_function_name/api' when deploying to Zoho Catalyst
VITE_API_BASE=/api
